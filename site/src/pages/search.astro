---
import Base from '../layouts/Base.astro';
import meta from '../data/meta.json';
import searchMeta from '../data/search_meta.json';
import { SITE_BASE } from '../config';
// 색인은 /data/search_index.json (public, 전체 도서) 을 런타임에 받아온다.
// 항목: [isbn13, 제목, 저자, 출판사, 출판년, 밴드, peak, 총대출, 상세페이지 유무, 그림책, kdc2, 형태idx, 성격비트, 비중13자]
const profAges: number[] = meta.profile_ages;
const labels: Record<string, string> = (meta as any).labels ?? {};
const kdc1Names: Record<string, string> = (meta as any).kdc1_names ?? {};
const kdc2Names: Record<string, string> = (meta as any).kdc2_names ?? {};
const flagTags: string[] = (meta as any).flag_tags ?? [];
const forms: string[] = (meta as any).forms ?? [];
const base = SITE_BASE;
const nBooks: number = searchMeta.n;
---
<Base title="책 검색">
  <h2>책 검색</h2>
  <p class="sub">제목·저자·출판사로 {nBooks.toLocaleString()}권 전체를 검색합니다. 결과의 막대는 나이별 선택 비중입니다.</p>
  <div class="tabs" style="align-items:center;gap:12px;flex-wrap:wrap">
    <input id="q" type="search" placeholder="예: 달님 안녕, 안녕달, 보림" autocomplete="off"
      style="flex:1;min-width:240px;padding:10px 12px;border:1px solid var(--line);border-radius:8px;font-size:15px" />
    <label><input id="picOnly" type="checkbox" /> 그림책만</label>
    <span id="count" class="sub" style="margin:0">색인 불러오는 중…</span>
  </div>
  <details class="filters" id="filters">
    <summary>필터 <span id="filterSummary" class="sub" style="margin:0"></span></summary>
    <div class="fgroup"><div class="flabel">분야</div>
      <div class="fchips">{Object.entries(kdc1Names).map(([k, n]) => <button class="chip" data-f="kdc1" data-v={k}>{n}</button>)}</div>
    </div>
    <div class="fgroup"><div class="flabel">형태</div>
      <div class="fchips">{forms.map((f) => <button class="chip" data-f="form" data-v={f}>{f}</button>)}</div>
    </div>
    <div class="fgroup"><div class="flabel">성격</div>
      <div class="fchips">{flagTags.map((t, i) => <button class="chip" data-f="flag" data-v={String(i)}>{t}</button>)}<button class="chip" id="clearFilters">필터 지우기</button></div>
    </div>
  </details>
  <div id="out" class="grid"></div>
  <div style="text-align:center;margin:16px 0"><button class="chip" id="moreBtn" type="button" hidden>더 보기</button></div>
  <script is:inline define:vars={{ profAges, labels, base, kdc1Names, kdc2Names, flagTags, forms }}>
    const $ = (s) => document.querySelector(s);
    const PAGE = 60;
    const norm = (s) => (s || '').toLowerCase().replace(/\s+/g, '');
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    let rows = [], hits = [], shown = 0;
    const state = { kdc1: new Set(), form: new Set(), flag: new Set() };
    const lib = window.AgeShelfLib?.get() || null; let libSet = null;
    if (lib) {
      const note = document.createElement('div'); note.className = 'notice';
      note.innerHTML = `<b>${esc(lib.name)}</b> 소장 도서만 표시 중(소장 정보가 있는 핵심 도서 기준). <button class="chip" id="libOff" type="button">해제</button>`;
      document.querySelector('main h2').after(note);
      document.getElementById('libOff').addEventListener('click', () => { window.AgeShelfLib.set(null); location.reload(); });
      window.AgeShelfLib.isbns(base, lib.code).then((s) => { libSet = s; render(); });
    }
    function card(b) {
      const prof = window.AgeShelfProf(b.prof);
      const max = Math.max(...prof, 1);
      const bars = profAges.map((a, k) => `<i style="height:${Math.max(6, Math.round(100 * (prof[k] || 0) / max))}%" title="${a}세 ${prof[k] || 0}%"></i>`).join('');
      const axis = profAges.map((a) => `<span>${a}</span>`).join('');
      const href = `${base}/b/?isbn=${b.isbn}`;
      const chips = [];
      if (b.k2 && kdc2Names[b.k2]) chips.push(`<span class="badge tag">${esc(kdc2Names[b.k2])}</span>`);
      if (b.fm) chips.push(`<span class="badge tag">${esc(b.fm)}</span>`);
      flagTags.forEach((t, i) => { if (((b.flb || 0) >> i) & 1 && chips.length < 5) chips.push(`<span class="badge tag flag">${esc(t)}</span>`); });
      return `<a class="card" href="${href}" style="grid-template-columns:1fr">
        <div><div class="title">${esc(b.title)}</div>
        <div class="meta">${esc(b.authors)} · ${esc(b.pub)} · ${esc(b.year)} · 총 대출 ${b.total.toLocaleString()}건</div>
        <div class="badges"><span class="badge band">추천 ${esc(b.band)}</span><span class="badge">가장 많이 고른 나이 ${labels[String(b.peak)] ?? b.peak + '세'}</span>${b.pic ? '<span class="badge pic">그림책</span>' : ''}${chips.join('')}</div>
        <div class="bars">${bars}</div><div class="axis">${axis}</div></div></a>`;
    }
    function syncChips() {
      document.querySelectorAll('.chip[data-f]').forEach((c) => c.classList.toggle('on', state[c.dataset.f].has(c.dataset.v)));
      const parts = [];
      state.kdc1.forEach((v) => parts.push(kdc1Names[v] || v)); state.form.forEach((v) => parts.push(v)); state.flag.forEach((v) => parts.push(flagTags[Number(v)] || v));
      $('#filterSummary').textContent = parts.length ? '· ' + parts.join(', ') : '';
    }
    function renderMore() {
      const chunk = hits.slice(shown, shown + PAGE);
      $('#out').insertAdjacentHTML('beforeend', chunk.map(card).join(''));
      shown += chunk.length;
      const left = hits.length - shown;
      $('#moreBtn').hidden = left <= 0; $('#moreBtn').textContent = left > 0 ? `더 보기 (남은 ${left.toLocaleString()}권)` : '';
    }
    function render() {
      syncChips();
      const q = norm($('#q').value);
      const picOnly = $('#picOnly').checked;
      const params = new URLSearchParams(location.search);
      if (q) params.set('q', $('#q').value); else params.delete('q');
      history.replaceState(null, '', `${location.pathname}${params.toString() ? '?' + params : ''}`);
      if (!rows.length) return;
      const filtering = state.kdc1.size || state.form.size || state.flag.size;
      $('#out').innerHTML = ''; shown = 0;
      if (q.length < 1 && !filtering) { hits = []; $('#count').textContent = ''; $('#moreBtn').hidden = true; return; }
      hits = rows.filter((b) => (!q || b.key.includes(q)) && (!picOnly || b.pic) && (!lib || (libSet && libSet.has(b.isbn)))
          && (!state.kdc1.size || state.kdc1.has((b.k2 || '')[0])) && (!state.form.size || state.form.has(b.fm))
          && (!state.flag.size || [...state.flag].every((f) => ((b.flb || 0) >> Number(f)) & 1)))
        .sort((x, y) => (q ? (norm(y.title).startsWith(q) - norm(x.title).startsWith(q)) : 0) || (y.total - x.total));
      $('#count').textContent = `${hits.length.toLocaleString()}건`;
      renderMore();
    }
    $('#q').addEventListener('input', render);
    $('#picOnly').addEventListener('change', render);
    $('#moreBtn').addEventListener('click', renderMore);
    document.querySelectorAll('.chip[data-f]').forEach((c) => c.addEventListener('click', () => {
      const s = state[c.dataset.f]; s.has(c.dataset.v) ? s.delete(c.dataset.v) : s.add(c.dataset.v); render();
    }));
    $('#clearFilters')?.addEventListener('click', () => { state.kdc1.clear(); state.form.clear(); state.flag.clear(); render(); });
    const q0 = new URLSearchParams(location.search).get('q');
    if (q0) { $('#q').value = q0; }
    $('#q').focus();
    fetch(`${base}/data/search_index.json?v=${window.__dataVersion || ''}`).then((r) => r.json()).then((index) => {
      rows = index.map((r) => ({ isbn: r[0], title: r[1], authors: r[2], pub: r[3], year: r[4], band: r[5], peak: r[6],
        total: r[7], hasPage: r[8], pic: r[9], k2: r[10] || '', fm: forms[r[11]] || '', flb: r[12] || 0, prof: r[13] || '',
        key: norm(r[1] + ' ' + r[2] + ' ' + r[3]) }));
      $('#count').textContent = '';
      render();
    }).catch(() => { $('#count').textContent = '색인을 불러오지 못했습니다.'; });
  </script>
</Base>
