---
import Base from '../../layouts/Base.astro';
import books from '../../data/books.json';
import meta from '../../data/meta.json';
import { SITE_BASE } from '../../config';
const base = SITE_BASE;
export async function getStaticPaths() {
  return Object.keys(books).map((isbn) => ({ params: { isbn } }));
}
const b = (books as Record<string, any>)[Astro.params.isbn!];
const profAges: number[] = meta.profile_ages;
const labels: Record<string, string> = (meta as any).labels ?? {};
const max = Math.max(...b.prof);
const th = 'text-align:left;padding:2px 8px 2px 0;white-space:nowrap';
const td = 'padding:2px 6px;text-align:right;color:#666';
const cents: number[] = b.cents ?? [];
const specs: number[] = b.specs ?? [];
const bestIdx = cents.length ? cents.indexOf(Math.max(...cents)) : -1;
const centMin: number = (meta as any).cent_min ?? 0.3;
const minLoans: number = (meta as any).min_loans ?? 30;
const gamma: number = (meta as any).gamma ?? 1;
const centMinPctText = Math.round(centMin * 100);
const flagTags: string[] = (meta as any).flag_tags ?? [];
const showAges: number[] = meta.ages;
// 태그 링크가 향할 나이 페이지: 중앙 나이를 사이트 노출 범위(1~7세)로 자름
const tagAge = Math.min(Math.max(Math.round(Number(b.median ?? b.peak)), showAges[0]), showAges[showAges.length - 1]);
---
<Base title={b.title}>
  <div class="card" style="grid-template-columns:120px 1fr;max-width:760px">
    <div>{b.cover ? <img class="cover" style="width:120px;height:165px" src={b.cover} alt="" /> : <div class="cover" style="width:120px;height:165px"></div>}</div>
    <div>
      <h2>{b.title}</h2>
      <div class="meta">{b.authors} · {b.publisher} · {b.year} · ISBN {b.isbn13}</div>
      <div class="badges">
        <span class="badge band">추천 연령 {b.band}</span>
        <span class="badge">중앙 {Number(b.median ?? b.peak).toFixed(1)}세</span>
        <span class="badge">가장 많이 고른 나이 {labels[String(b.peak)] ?? b.peak + '세'}</span>
        <span class="badge">분포 폭 {b.spread.toFixed(1)}세</span>
        <span class="badge">{b.shape}{b.skew ? ` (왜도 ${b.skew.toFixed(2)})` : ''}</span>
        {b.picture && <span class="badge pic">그림책</span>}
      </div>
      <div class="badges" style="margin-top:6px">
        {b.kdc2n && <a class="badge tag" href={`${base}/age/${tagAge}?kdc2=${b.kdc2}`} title="이 나이 페이지에서 같은 분야 보기">{b.kdc1n} › {b.kdc2n}</a>}
        {b.form && <a class="badge tag" href={`${base}/age/${tagAge}?form=${encodeURIComponent(b.form)}`}>{b.form}</a>}
        {b.pubn && <a class="badge tag" href={`${base}/age/${tagAge}?pub=${encodeURIComponent(b.pubn)}`}>{b.pubn}</a>}
        {(b.flags ?? []).map((t: string) => <a class="badge tag flag" href={`${base}/age/${tagAge}?flag=${flagTags.indexOf(t)}`}>{t}</a>)}
      </div>
      <h3 style="font-size:14px;margin:16px 0 4px">나이별 선택 비중 (코호트 크기 보정 γ={gamma}, 스무딩)</h3>
      <div class="bars" style="height:80px">{profAges.map((a, i) => <i class={(i === bestIdx ? 'on ' : '') + (b.obs[i] ? '' : 'miss')} style={`height:${Math.max(4, Math.round(100 * b.prof[i] / max))}%`} title={`${a}세 ${(100 * b.prof[i]).toFixed(1)}% · ${b.loans[i].toLocaleString()}건 · 위치 ${Math.floor((cents[i] ?? 0) * 100)}%`}></i>)}</div>
      <div class="axis">{profAges.map((a) => <span>{a}세</span>)}</div>
      <div style="overflow-x:auto">
      <table style="font-size:12px;margin-top:12px;border-collapse:collapse">
        <tr><th style={th}>나이</th>{profAges.map((a) => <td style={td}>{a}</td>)}</tr>
        <tr><th style={th}>대출</th>{b.loans.map((v: number, i: number) => <td style={td}>{b.obs[i] ? v.toLocaleString() : ((b.upper?.[i] ?? 0) > 0 ? `<${b.upper[i].toLocaleString()}` : '0')}</td>)}</tr>
        <tr><th style={th}>이 나이 위치</th>{cents.map((v: number) => <td style={td + (v >= centMin ? ';font-weight:600;color:var(--accent2)' : '')}>{Math.floor(v * 100)}%</td>)}</tr>
        <tr><th style={th}><b>추천도</b></th>{(b.fits ?? []).map((v: number, i: number) => <td style={td + ((cents[i] ?? 0) >= centMin && b.loans[i] >= minLoans ? ';font-weight:700;color:var(--accent)' : '')}>{(cents[i] ?? 0) >= centMin && b.loans[i] >= minLoans ? v.toLocaleString() : '–'}</td>)}</tr>
        <tr><th style={th}>집중도</th>{specs.map((v: number) => <td style={td}>{v.toFixed(1)}</td>)}</tr>
        <tr><th style={th}>lift(참고)</th>{b.lifts.map((v: number) => <td style={td}>{v.toFixed(2)}</td>)}</tr>
      </table>
      </div>
      <p class="sub" style="font-size:12px;margin-top:8px">
        <b>추천도</b> = 그 나이 대출수 × 이 나이 위치. 나이별 "딱 맞는 책" 순위는 이 값으로 매기며, 위치 {centMinPctText}% 미만이거나 대출 {minLoans}건 미만인 나이는 후보에서 빠집니다(–).
        <b>이 나이 위치</b>는 이 책 독자 분포에서 그 나이가 중앙에 얼마나 가까운지(중앙 100%, 양 끝 0%),
        <b>집중도</b>는 13개 나이에 고르게 퍼졌을 때 1이며 클수록 그 나이에 몰린 책입니다. 미관측 나이의 대출은 1~8세에서는 "&lt;상한", 9세 이상은 0으로 계산합니다.
      </p>
      {b.detail && <p style="font-size:13px"><a href={b.detail} target="_blank" rel="noopener" style="color:var(--accent2)">정보나루 도서 상세 →</a></p>}
    </div>
  </div>
  <section id="holdings" class="card" style="grid-template-columns:1fr;max-width:760px;margin-top:12px" hidden>
    <div>
      <h3 style="font-size:15px;margin:0 0 6px">소장 도서관 <span id="holdCount" class="sub" style="margin:0"></span></h3>
      <p class="sub" style="font-size:12px;margin:0 0 8px">소장 여부는 수집 시점의 ISBN 기준입니다. 지금 대출 가능한지는 도서관 홈페이지에서 확인하세요. <button class="chip" id="holdNear" type="button">내 위치에서 가까운 순</button></p>
      <div id="holdList" style="font-size:13px"></div>
    </div>
  </section>
  <script is:inline define:vars={{ libCodes: b.libs ?? [], base, regionNames: (meta as any).region_names ?? {} }}>
    (async () => {
      if (!libCodes.length || !window.AgeShelfLib) return;
      const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      const dir = await window.AgeShelfLib.directory(base);
      const set = new Set(libCodes);
      let libs = dir.libs.filter((l) => set.has(l.code));
      const sec = document.getElementById('holdings'); sec.hidden = false;
      document.getElementById('holdCount').textContent = `${libs.length}곳`;
      const mine = window.AgeShelfLib.get();
      function draw(sorted, withDist) {
        const byRegion = {};
        sorted.forEach((l) => { (byRegion[l.region] ??= []).push(l); });
        document.getElementById('holdList').innerHTML = Object.entries(byRegion).map(([r, ls]) => `
          <div style="margin:6px 0"><b>${esc(regionNames[r] || r)}</b> <span class="sub" style="margin:0">${ls.length}곳</span>
          <div class="badges">${ls.map((l) => `<a class="badge${mine && mine.code === l.code ? ' band' : ''}" href="${l.home ? esc(l.home) : '#'}" ${l.home ? 'target="_blank" rel="noopener"' : ''} title="${esc(l.addr)}${l.hours ? ' · ' + esc(l.hours) : ''}">${esc(l.name)}${withDist && l.d != null ? ` · ${l.d.toFixed(1)}km` : ''}</a>`).join('')}</div></div>`).join('');
      }
      draw(libs.sort((a, b) => a.name.localeCompare(b.name, 'ko')), false);
      document.getElementById('holdNear').addEventListener('click', () => {
        if (!navigator.geolocation) return alert('이 브라우저는 위치를 지원하지 않습니다.');
        navigator.geolocation.getCurrentPosition((pos) => {
          const { latitude: la, longitude: lo } = pos.coords;
          libs = libs.map((l) => ({ ...l, d: (l.lat && l.lon) ? window.AgeShelfLib.dist(la, lo, l.lat, l.lon) : null })).sort((a, b) => (a.d ?? 1e9) - (b.d ?? 1e9));
          draw(libs, true);
        }, () => alert('위치를 가져오지 못했습니다.'));
      });
    })();
  </script>
</Base>
