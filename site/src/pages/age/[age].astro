---
import Base from '../../layouts/Base.astro';
import BookCard from '../../components/BookCard.astro';
import meta from '../../data/meta.json';
import { SITE_BASE } from '../../config';
export async function getStaticPaths() {
  return (meta.ages as number[]).map((age) => ({ params: { age: String(age) } }));
}
const age = Number(Astro.params.age);
const data = (await import(`../../data/ages/${age}.json`)).default;
const label = (meta as any).labels?.[String(age)] ?? `${age}세`;
const centMinPct = Math.round(((meta as any).cent_min ?? 0.3) * 100);
const minLoans = (meta as any).min_loans ?? 30;
const facets = data.facets ?? { kdc2: [], form: [], pub: [], flag: [] };
const kdc2Names: Record<string, string> = (meta as any).kdc2_names ?? {};
const flagTags: string[] = (meta as any).flag_tags ?? [];
const profAges: number[] = meta.profile_ages;
const base = SITE_BASE;
const holdings = (meta as any).holdings ?? { regions: [], n_books: 0, n_libs: 0 };
const regionNames: Record<string, string> = (meta as any).region_names ?? {};
const holdRegions: string[] = holdings.regions ?? [];
const nEligible: number = data.n_eligible ?? 0;
const nIndex: number = data.n_index ?? 0;
const wCent: number = (meta as any).w_cent ?? 50;
const wPop: number = (meta as any).w_pop ?? 50;
const groups: Record<string, any[]> = {};
for (const row of facets.kdc2 as any[]) { const g = row[2] || '기타'; (groups[g] ??= []).push(row); }
const groupOrder = Object.keys(groups).sort((x, y) => (groups[y].reduce((s: number, r: any) => s + r[3], 0)) - (groups[x].reduce((s: number, r: any) => s + r[3], 0)));
---
<Base title={`${label} 인기 도서`}>
  <h2>{label}</h2>
  {age === 1 && <div class="notice">0세 카드 대출은 생년이 없는 학급·기관 단체대출이 대부분이라 순위에서 제외했습니다. 이 페이지는 1세(12~23개월) 카드 대출을 기준으로 하며, 상위권은 대부분 0세부터 보는 아기 그림책입니다.</div>}
  <p class="sub">
    <b>딱 맞는 책</b>은 {label}에 대한 <b>연령 적합도</b>(이 책 독자 분포에서 {label}가 중앙에 얼마나 가까운지, 0~100%)가 {centMinPct}% 이상이고 대출 {minLoans}건 이상인 책만 골라 <b>추천도</b>(100점 = 적합도 점수 {wCent} + 인기 점수 {wPop}, 인기는 {label} 대출수를 로그로 그 나이 최대 대비 환산) 순으로 정렬한 목록입니다.
    적합도는 이미 지난 어린 책에는 엄격하게, 앞으로 볼 큰 책에는 너그럽게 매깁니다.
    <b>많이 빌린 책</b>은 {label} 대출 건수순입니다. 후보 {nEligible.toLocaleString()}권 전체를 아래로 내려가며 볼 수 있습니다.
  </p>

  <details class="filters" id="filters">
    <summary>필터 <span id="filterSummary" class="sub" style="margin:0"></span></summary>
    {holdRegions.length > 0 && <div class="fgroup"><div class="flabel">도서관</div>
      <div class="fchips">
        <select id="libRegion"><option value="">지역 선택</option>{holdRegions.map((r) => <option value={r}>{regionNames[r] ?? r}</option>)}</select>
        <select id="libSelect" disabled><option value="">도서관 선택</option></select>
        <button class="chip" id="libNear" type="button">내 주변</button>
        <button class="chip" id="libClear" type="button" hidden>도서관 해제</button>
        <span class="sub" style="margin:0;font-size:11px">소장 정보: {holdRegions.map((r) => `${regionNames[r] ?? r} ${Number((holdings.by_region ?? {})[r] ?? 0).toLocaleString()}권`).join(' · ')} (도서관 {Number(holdings.n_libs).toLocaleString()}곳)</span>
      </div>
    </div>}
    <div class="fgroup"><div class="flabel">분야</div>
      <div class="fchips">{groupOrder.map((g) => <span class="fsub"><b>{g}</b>{groups[g].map((r: any) => <button class="chip" data-f="kdc2" data-v={r[0]} title={`${r[3]}권`}>{r[1]} <small>{r[3]}</small></button>)}</span>)}</div>
    </div>
    <div class="fgroup"><div class="flabel">형태</div>
      <div class="fchips">{(facets.form as any[]).map((r) => <button class="chip" data-f="form" data-v={r[0]}>{r[0]} <small>{r[1]}</small></button>)}</div>
    </div>
    <div class="fgroup"><div class="flabel">성격</div>
      <div class="fchips">{(facets.flag as any[]).map((r) => <button class="chip" data-f="flag" data-v={String(r[0])}>{r[1]} <small>{r[2]}</small></button>)}</div>
    </div>
    <div class="fgroup"><div class="flabel">출판사</div>
      <div class="fchips">
        <select id="pubSelect"><option value="">전체</option>{(facets.pub as any[]).map((r) => <option value={r[0]}>{r[0]} ({r[1]})</option>)}</select>
        <button class="chip" id="clearFilters">필터 지우기</button>
      </div>
    </div>
  </details>

  <div class="tabs">
    <button class="on" data-tab="fit">{label}에 딱 맞는 책</button>
    <button data-tab="popular">{label}가 많이 빌린 책</button>
    <label id="noisyWrap" class="sub" style="margin:0 0 0 auto;font-size:12px;display:none"><input type="checkbox" id="showNoisy" /> 타연령 책도 보기</label>
  </div>
  <p class="sub" id="listInfo" style="margin:0 0 10px"></p>
  <!-- 첫 화면: 서버에서 그린 상위 60권. 색인이 로드되면 아래 목록이 이어 붙는다 -->
  <section id="teaser" class="grid">{data.fit.map((b: any, i: number) => <BookCard b={b} rank={i + 1} age={age} mode="fit" />)}</section>
  <section id="list" class="grid"></section>
  <div id="more" style="text-align:center;margin:16px 0">
    <button class="chip" id="moreBtn" type="button" hidden>더 보기</button>
    <span id="moreInfo" class="sub" style="margin:0"></span>
  </div>

  <script is:inline define:vars={{ age, label, profAges, base, kdc2Names, flagTags, regionNames, nEligible, nIndex, teaserN: (meta as any).teaser_n ?? 60 }}>
    const $ = (s) => document.querySelector(s);
    const PAGE = 100;
    const state = { kdc2: new Set(), form: new Set(), flag: new Set(), pub: '', lib: null, tab: 'fit', noisy: false };
    let index = null, loading = null, libSet = null, libSetCode = null;
    let current = [];      // 현재 조건의 전체 결과 (시리즈 캡 적용, 순서대로)
    let shown = 0;
    const params = new URLSearchParams(location.search);
    for (const f of ['kdc2', 'form', 'flag']) (params.get(f) || '').split(',').filter(Boolean).forEach((v) => state[f].add(v));
    state.pub = params.get('pub') || '';
    if (params.get('tab') === 'popular') state.tab = 'popular';
    state.lib = window.AgeShelfLib?.get() || null;

    function filtersActive() { return state.kdc2.size || state.form.size || state.flag.size || state.pub || state.lib; }
    function syncUI() {
      document.querySelectorAll('.chip[data-f]').forEach((c) => c.classList.toggle('on', state[c.dataset.f].has(c.dataset.v)));
      const sel = $('#pubSelect'); if (sel) sel.value = state.pub;
      document.querySelectorAll('.tabs button').forEach((x) => x.classList.toggle('on', x.dataset.tab === state.tab));
      $('#noisyWrap').style.display = state.tab === 'popular' ? '' : 'none';
      const parts = [];
      if (state.lib) parts.push(`${state.lib.name} 소장`);
      state.kdc2.forEach((v) => parts.push(kdc2Names[v] || v)); state.form.forEach((v) => parts.push(v));
      state.flag.forEach((v) => parts.push(flagTags[Number(v)] || v)); if (state.pub) parts.push(state.pub);
      $('#filterSummary').textContent = parts.length ? '· ' + parts.join(', ') : '';
      const clr = $('#libClear'); if (clr) clr.hidden = !state.lib;
      const p = new URLSearchParams();
      for (const f of ['kdc2', 'form', 'flag']) if (state[f].size) p.set(f, [...state[f]].join(','));
      if (state.pub) p.set('pub', state.pub); if (state.tab === 'popular') p.set('tab', 'popular');
      history.replaceState(null, '', location.pathname + (p.toString() ? '?' + p : ''));
    }
    async function loadIndex() {
      if (index) return index;
      loading ??= fetch(`${base}/data/index/${age}.json?v=${window.__dataVersion || ''}`).then((r) => r.json()).then((j) => {
        j.cards = j.rows.map((r) => window.AgeShelfRow(r, j)); index = j; return j;
      });
      return loading;
    }
    async function loadLibSet() {
      if (!state.lib) { libSet = null; libSetCode = null; return null; }
      if (libSetCode === state.lib.code) return libSet;
      libSet = await window.AgeShelfLib.isbns(base, state.lib.code); libSetCode = state.lib.code; return libSet;
    }
    function compute() {
      const ls = libSet;
      let rows = index.cards.filter((b) =>
        (!ls || ls.has(b.i)) &&
        (!state.kdc2.size || state.kdc2.has(b.k2)) && (!state.form.size || state.form.has(b.fm)) &&
        (!state.flag.size || [...state.flag].every((f) => ((b.flb || 0) >> Number(f)) & 1)) && (!state.pub || b.pn === state.pub));
      if (state.tab === 'popular') rows = rows.filter((b) => b.pr > 0 && (state.noisy || b.ce >= 0.2)).sort((x, y) => x.pr - y.pr);
      else rows = rows.filter((b) => b.elig).sort((x, y) => y.fit - x.fit);
      return rows;
    }
    function renderMore() {
      const chunk = current.slice(shown, shown + PAGE);
      $('#list').insertAdjacentHTML('beforeend', chunk.map((b, k) => window.AgeShelfCard(b, { rank: shown + k + 1, age, ageLabel: label, profAges, base, kdcNames: kdc2Names, flagTags })).join(''));
      shown += chunk.length;
      const left = current.length - shown;
      $('#moreBtn').hidden = left <= 0;
      $('#moreBtn').textContent = left > 0 ? `더 보기 (${Math.min(PAGE, left)}권 더 · 남은 ${left.toLocaleString()}권)` : '';
      $('#moreInfo').textContent = left <= 0 ? (current.length ? '목록 끝' : '') : '';
    }
    async function render() {
      syncUI();
      const filtered = !!filtersActive();
      if (!index && !filtered && state.tab === 'fit') {          // 색인 없이도 첫 화면은 서버 카드로
        $('#teaser').hidden = false; $('#list').innerHTML = '';
        $('#listInfo').textContent = `후보 ${nEligible.toLocaleString()}권 중 상위 ${teaserN}권 · 전체 목록 불러오는 중…`;
        return;
      }
      $('#listInfo').textContent = '불러오는 중…';
      try { await Promise.all([loadIndex(), loadLibSet()]); }
      catch (e) { $('#listInfo').textContent = '목록 데이터를 불러오지 못했습니다. 새로고침(Ctrl+F5) 해 주세요.'; console.error(e); return; }
      current = compute(); shown = 0;
      $('#teaser').hidden = true; $('#list').innerHTML = '';
      const order = state.tab === 'popular' ? `${label} 대출 건수순` : '추천도(적합도 + 인기, 100점)순';
      const libNote = state.lib ? ` · ${state.lib.name} 소장 도서만` : '';
      $('#listInfo').textContent = `후보 ${nEligible.toLocaleString()}권 중 ${current.length.toLocaleString()}권 · ${order}${libNote}`;
      renderMore();
    }
    // 도서관 피커
    async function fillLibs(region, preselect) {
      const sel = $('#libSelect'); if (!sel) return;
      sel.disabled = true; sel.innerHTML = '<option value="">불러오는 중…</option>';
      let dir;
      try { dir = await window.AgeShelfLib.directory(base); }
      catch (e) { sel.innerHTML = '<option value="">도서관 목록을 불러오지 못했습니다 (새로고침)</option>'; console.error(e); return; }
      const libs = dir.libs.filter((l) => l.region === region && l.n > 0).sort((a, b) => a.name.localeCompare(b.name, 'ko'));
      sel.innerHTML = '<option value="">도서관 선택</option>' + libs.map((l) => `<option value="${l.code}">${l.name} (${l.n})</option>`).join('');
      sel.disabled = false; if (preselect) sel.value = preselect;
    }
    function selectLib(code, name, region) {
      state.lib = code ? { code, name, region } : null; window.AgeShelfLib.set(state.lib); render();
    }
    $('#libRegion')?.addEventListener('change', (e) => { fillLibs(e.target.value); });
    $('#libSelect')?.addEventListener('change', (e) => {
      const o = e.target.selectedOptions[0]; selectLib(e.target.value, o ? o.textContent.replace(/ \(\d+\)$/, '') : '', $('#libRegion').value);
    });
    $('#libClear')?.addEventListener('click', () => { selectLib(null); const s = $('#libSelect'); if (s) s.value = ''; });
    $('#libNear')?.addEventListener('click', () => {
      if (!navigator.geolocation) { alert('이 브라우저는 위치를 지원하지 않습니다.'); return; }
      navigator.geolocation.getCurrentPosition(async (pos) => {
        const dir = await window.AgeShelfLib.directory(base);
        const { latitude: la, longitude: lo } = pos.coords;
        const near = dir.libs.filter((l) => l.n > 0 && l.lat && l.lon).map((l) => ({ ...l, d: window.AgeShelfLib.dist(la, lo, l.lat, l.lon) })).sort((a, b) => a.d - b.d).slice(0, 15);
        if (!near.length) { alert('소장 정보가 있는 도서관이 없습니다.'); return; }
        const sel = $('#libSelect');
        sel.innerHTML = '<option value="">가까운 도서관 선택</option>' + near.map((l) => `<option value="${l.code}">${l.name} · ${l.d.toFixed(1)}km (${l.n})</option>`).join('');
        sel.disabled = false; $('#libRegion').value = near[0].region;
        sel.value = near[0].code; selectLib(near[0].code, near[0].name, near[0].region);
      }, () => alert('위치를 가져오지 못했습니다.'));
    });
    if (state.lib) { const r = $('#libRegion'); if (r) { r.value = state.lib.region || ''; fillLibs(state.lib.region, state.lib.code); } }

    document.querySelectorAll('.chip[data-f]').forEach((c) => c.addEventListener('click', () => {
      const s = state[c.dataset.f]; s.has(c.dataset.v) ? s.delete(c.dataset.v) : s.add(c.dataset.v); render();
    }));
    $('#pubSelect')?.addEventListener('change', (e) => { state.pub = e.target.value; render(); });
    $('#clearFilters')?.addEventListener('click', () => {
      state.kdc2.clear(); state.form.clear(); state.flag.clear(); state.pub = '';
      state.lib = null; window.AgeShelfLib?.set(null); const ls = $('#libSelect'); if (ls) ls.value = '';
      render();
    });
    document.querySelectorAll('.tabs button').forEach((btn) => btn.addEventListener('click', () => { state.tab = btn.dataset.tab; render(); }));
    $('#showNoisy').addEventListener('change', (e) => { state.noisy = e.target.checked; render(); });
    $('#moreBtn').addEventListener('click', renderMore);
    // 카드 안 태그 칩 클릭 → 필터 적용
    document.addEventListener('click', (e) => {
      const t = e.target.closest('.badge.tag'); if (!t) return;
      e.preventDefault(); const s = state[t.dataset.f]; if (s && !s.has(t.dataset.v)) { s.add(t.dataset.v); render(); }
    });
    // 스크롤이 '더 보기'에 닿으면 자동으로 이어 그리기
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((es) => { if (es.some((x) => x.isIntersecting) && !$('#moreBtn').hidden) renderMore(); }, { rootMargin: '600px' }).observe($('#more'));
    }
    if (filtersActive() || state.tab === 'popular') { $('#filters').open = !!filtersActive(); render(); }
    else { render(); loadIndex().then(() => { if (!filtersActive() && state.tab === 'fit') render(); }).catch(() => {}); }
  </script>
</Base>
